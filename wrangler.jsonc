{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iaq-dashboard",
  "compatibility_date": "2026-09-27",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
